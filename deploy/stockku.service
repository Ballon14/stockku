[Unit]
Description=StockKu Laravel Application Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/stockku
ExecStart=/usr/bin/php /root/stockku/artisan serve --host=127.0.0.1 --port=8000
Restart=always
RestartSec=3
Environment=APP_ENV=production

[Install]
WantedBy=multi-user.target